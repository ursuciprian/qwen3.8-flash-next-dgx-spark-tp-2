From be5c36c47c66b0eda9483faaf95e068224ea254a Mon Sep 17 00:00:00 2001
From: Ciprian Ursu <ciprian.ursu@deepstash.com>
Date: Mon, 21 Sep 2026 00:19:39 +0300
Subject: [PATCH] perf(parser): only force a tool-call grammar when tool_choice
 actually forces one (a229c7a1)

a229c7a1 already carries the cherry-picked 5d1df69f fix (commit 9e0825c968:
honor tool_choice=required for models on the shared ParserEngine, reasoning=
passed through) but still gates the structural tag on tool_choice="auto"
as well as required/named, and parser_manager.py mutates the shared
ParserEngine subclass in place. It also calls
ParserManager._get_parser_engine_cls(), which was never ported into KKs
parser_manager.py (it is upstream 1a20d23dab, dropped somewhere in KKs
integration history even though the adapters machinery it reads is still
present) -- every server boot with both --reasoning-parser and
--tool-call-parser set crashes at startup with AttributeError before ever
reaching the code this fix touches.

"auto" leaves the model free to answer in prose, so the tag constrains
nothing it was not already allowed to emit -- it only buys well-formed
syntax once the model commits to a call, but puts the request on the
structured-output path for its whole lifetime (deferred sampling in
EngineCore.step_with_batch_queue, the draft-token D2H copy async scheduling
otherwise skips, the grammar bitmask fill/copy/kernel, and grammar
rejection of MTP drafts). Measured on the jovian image: c1 decode 97 ->
85-88 tok/s, MTP acceptance 3.15 -> 2.77 tokens per draft, c4/c8/c16
unchanged.

Restore _get_parser_engine_cls verbatim from jovian (self-contained static
method, no other dependency). Split the gate and tag construction into
needs_structural_tag() / attach_structural_tag() shared by DelegatingParser
and ParserEngine. Gate on required/named only. parser_manager.py points a
per-call subclass at the resolved tool/reasoning parser classes instead of
mutating the shared collapsed engine class, which is process-wide state
every other model backed by it would inherit. ParserEngine.adjust_request()
checks the gate before instantiating a tool parser (instantiating one
constructs a second parser engine).

Combines the jovian (0001) and KK (0002) fixes for a229c7a1, which already
had the 5d1df69f cherry-pick baked in.
---
 vllm/parser/abstract_parser.py      | 78 ++++++++++++++++++-----------
 vllm/parser/engine/parser_engine.py | 78 +++++++++++------------------
 vllm/parser/parser_manager.py       | 45 +++++++++++++----
 3 files changed, 114 insertions(+), 87 deletions(-)

diff --git a/vllm/parser/abstract_parser.py b/vllm/parser/abstract_parser.py
index 5d127f6576..fca3af016e 100644
--- a/vllm/parser/abstract_parser.py
+++ b/vllm/parser/abstract_parser.py
@@ -402,6 +402,47 @@ class Parser:
         return 0
 
 
+def needs_structural_tag(
+    request: "ChatCompletionRequest | ResponsesRequest",
+) -> bool:
+    """Whether the request must be grammar-constrained into a tool call.
+
+    Only ``required`` and named tool choices force one. ``auto`` leaves the
+    model free to answer in prose, so a structural tag changes nothing it is
+    allowed to emit -- but it does put the request on the engine's
+    structured-output path for its whole lifetime: a per-step grammar bitmask
+    fill, H2D copy and mask kernel, deferred sampling in
+    EngineCore.step_with_batch_queue() (which drops async-scheduling overlap
+    for the *whole* batch), and grammar rejection of speculative draft
+    tokens. Keep the grammar for the case that actually needs it.
+    """
+    if not getattr(request, "tools", None):
+        return False
+    tool_choice = getattr(request, "tool_choice", None)
+    return tool_choice == "required" or isinstance(
+        tool_choice, (ChatCompletionNamedToolChoiceParam, ToolChoiceFunction)
+    )
+
+
+def attach_structural_tag(
+    request: "ChatCompletionRequest | ResponsesRequest",
+    tool_parser,
+    *,
+    reasoning: bool,
+) -> None:
+    """Build ``tool_parser``'s xgrammar structural tag onto ``request``."""
+    structure_tag = tool_parser.get_structural_tag(request, reasoning=reasoning)
+    if structure_tag is None:
+        return
+    request.structured_outputs = StructuredOutputsParams(
+        structural_tag=json.dumps(structure_tag.model_dump()),
+    )
+    if isinstance(request, ResponsesRequest):
+        request.text = None
+    else:
+        request.response_format = None
+
+
 class DelegatingParser(Parser):
     """
     A Parser implementation that delegates to separate ReasoningParser and
@@ -565,38 +606,15 @@ class DelegatingParser(Parser):
         self, request: ChatCompletionRequest | ResponsesRequest
     ) -> ChatCompletionRequest | ResponsesRequest:
         if (
-            self._tool_parser is None
-            or self._tool_parser.structural_tag_model is None
-            or not request.tools
+            self._tool_parser is not None
+            and self._tool_parser.structural_tag_model is not None
+            and needs_structural_tag(request)
         ):
-            return request
-
-        need_tool_calling = (
-            request.tool_choice == "auto"
-            or request.tool_choice == "required"
-            or isinstance(
-                request.tool_choice,
-                (ChatCompletionNamedToolChoiceParam, ToolChoiceFunction),
+            attach_structural_tag(
+                request,
+                self._tool_parser,
+                reasoning=self._reasoning_parser is not None,
             )
-        )
-        if not need_tool_calling:
-            return request
-
-        structure_tag = self._tool_parser.get_structural_tag(
-            request,
-            reasoning=self._reasoning_parser is not None,
-        )
-        if structure_tag is None:
-            return request
-
-        structural_tag = json.dumps(structure_tag.model_dump())
-        request.structured_outputs = StructuredOutputsParams(
-            structural_tag=structural_tag,
-        )
-        if isinstance(request, ResponsesRequest):
-            request.text = None
-        else:
-            request.response_format = None
         return request
 
     def extract_reasoning_streaming(
