+# ---------------------------------------------------------------------------
+# Multi-row vocabulary projection (b12x gemm.bf16_gemv)
+#
+# b12x's gemm.bf16_vocab_projection only owns a native kernel at
+# ``max_tokens == 1``: its tuning contract rejects the Triton backend for any
+# other capacity, so every multi-row plan resolves to ``backend="torch"``,
+# i.e. ``F.linear`` -> cuBLAS.  At an MTP verify step (M = 1 + speculative
+# tokens) that is cuBLAS's one-warp SM80 WMMA small-M fallback: measured
+# 3.60 ms/step for a [124160, 2560] BF16 head on GB10, 65% of the LPDDR5x
+# roofline, while the weight is streamed exactly once either way.
+#
+# gemm.bf16_gemv's SIMT backend loads each weight row once and accumulates up
+# to ``SMALL_M_MAX`` source rows against it -- exactly the verify shape.  It is
+# NOT bit-identical: both kernels accumulate bf16 products (which are exact in
+# fp32) into fp32 registers, but in a different order.
+#
+# ``VLLM_B12X_VOCAB_GEMV=0`` reverts to the stock route without a rebuild.
+# See results/kernel-pass/lmhead-hc-design.md.
+# ---------------------------------------------------------------------------
+_VOCAB_GEMV_ENABLED = os.getenv("VLLM_B12X_VOCAB_GEMV", "1").lower() not in (
+    "0",
+    "off",
+    "false",
+    "no",
+)
+
+
+@cache
+def _b12x_vocab_gemv():
+    """The b12x small-M BF16 GEMV module, or None when it cannot serve here."""
+    if not _VOCAB_GEMV_ENABLED:
+        return None
+    api = get_b12x_bf16_gemv()
+    if api is None:
+        return None
+    try:
+        if not api.is_supported():
+            return None
+    except Exception:  # noqa: BLE001 - absence is a routing decision
+        return None
+    return api
+
+
