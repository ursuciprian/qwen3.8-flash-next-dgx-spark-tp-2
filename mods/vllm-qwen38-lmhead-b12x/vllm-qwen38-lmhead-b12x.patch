-                out_features=out_features,
+        api = _b12x_vocab_gemv() if gemv and rows > 1 else None
+        if (
+            api is not None
+            and rows <= api.SMALL_M_MAX
+            and in_features % 8 == 0
+            and head.weight.is_contiguous()
+            and not head.weight.data_ptr() % 16
+        ):
+            # A prepared exact-capacity GEMV; the launch grid uses the live
+            # row count, so one plan serves every M up to ``rows``.
+            plan = api.plan(
+                api.GemvQuery(
+                    source_dtype="bfloat16",
+                    weight_dtype="bfloat16",
+                    max_rows=rows,
+                    in_features=in_features,
+                    out_features=out_features,
+                    source_contiguous=True,
+                    source_aligned=True,
+                    weight_contiguous=True,
+                    weight_aligned=True,
+                )
+            )
+        else:
+            plan = projection.plan(
+                projection.Caps(
+                    device=head.weight.device,
+                    max_tokens=rows,
+                    in_features=in_features,
+                    out_features=out_features,
+                )
             )
+        logger.info(
+            "b12x vocab projection plan: head=%dx%d capacity=%d component=%s",
+            out_features,
+            in_features,
+            rows,
+            plan.contract.component_id,
         )
+        return plan
 
