+    def get_top_tokens(
+        self, hidden_states: torch.Tensor, spec_step_idx: int = 0
+    ) -> torch.Tensor:
+        # Experimental draft-only approximation. compute_logits and the shared
+        # target head stay unchanged. A shortlist can miss the true winner.
+        head = self.lm_head
+        weight = head.weight
+        if weight.dtype != torch.bfloat16 or hidden_states.dtype != torch.bfloat16:
+            raise ValueError("FP8 refined drafting requires the unquantized BF16 head")
+        if head.shard_indices.num_added_elements:
+            raise ValueError("FP8 refined drafting does not support added vocabulary")
+        processor = self.logits_processor
+        if processor.scale != 1.0 or processor.soft_cap is not None or processor.head_dtype not in (None, torch.bfloat16):
+            raise ValueError("FP8 refined drafting requires the default logits transform")
+        if hidden_states.shape[0] == 0:
+            return torch.empty(0, dtype=torch.int64, device=hidden_states.device)
+        if getattr(self, "_draft_head_source_ptr", None) != weight.data_ptr():
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("Warm the FP8 draft head eagerly before CUDA graph capture")
+            # Existing fused quantizer avoids full-sized float32 scratch copies.
+            packed, scale = ops.scaled_fp8_quant(weight)
+            self.register_buffer("_draft_head_fp8_weight", packed.t(), persistent=False)
+            self.register_buffer("_draft_head_fp8_scale", scale, persistent=False)
+            self._draft_head_source_ptr = weight.data_ptr()
+        quantized, scale = ops.scaled_fp8_quant(hidden_states)
+        approximate = torch._scaled_mm(
+            quantized, self._draft_head_fp8_weight, scale_a=scale,
+            scale_b=self._draft_head_fp8_scale, out_dtype=torch.bfloat16,
+            use_fast_accum=True)
+        valid = head.shard_indices.num_org_elements
+        approximate[:, valid:] = -float("inf")
+        ids = approximate.topk(min(8, approximate.shape[-1]), dim=-1).indices
+        rows = torch.nn.functional.embedding(ids, weight)
+        scores = torch.bmm(rows, hidden_states.unsqueeze(-1)).squeeze(-1)
+        scores.masked_fill_(ids >= valid, -float("inf"))
+        best = scores.amax(-1, keepdim=True)
+        local_ids = torch.where(scores == best, ids, weight.shape[0]).amin(-1)
+        global_ids = local_ids + head.shard_indices.org_vocab_start_index
+        if head.tp_size == 1:
+            return global_ids
+        pair = torch.stack((best.squeeze(-1).float(), global_ids.float()), dim=-1)
+        gathered = tensor_model_parallel_all_gather(pair, dim=-1).view(-1, head.tp_size, 2)
+        winners = gathered[:, :, 0] == gathered[:, :, 0].amax(-1, keepdim=True)
+        return torch.where(winners, gathered[:, :, 1], processor.org_vocab_size).amin(-1).to(torch.int64)
